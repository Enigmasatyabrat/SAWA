# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data & models
# Sample photos are large; manifest.csv is the tracked source of truth and
# references them by path. Keep the images backed up outside the repo.
data/samples/*.jpg
data/samples/*.jpeg
data/samples/*.png
src/lib/ml/*.pkl
src/lib/ml/*.joblib
src/lib/ml/*.onnx

# build artifacts
/dist

# IDE
.vscode
.idea
*.swp
*.swo

# OS
Thumbs.db

# backups
backup-*
